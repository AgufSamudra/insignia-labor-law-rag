EMBEDDING_MODEL=BAAI/bge-m3-multi
RERANKED_MODEL=Qwen/Qwen3-Reranker-4B
GENERATIVE_MODEL=Qwen/Qwen3-32B
DEEPINFRA_API_KEY=your_deepinfra_api_key

# Qdrant REST API (default REST port is 6333; 6334 is gRPC)
QDRANT_HOST=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=insignia_labor_law_chunks

# Keep this bounded because BGE-M3 sparse responses can be large.
EMBEDDING_BATCH_SIZE=8
HTTP_TIMEOUT_SECONDS=120

# User-query pipeline
RETRIEVAL_LIMIT=20
RERANK_TOP_K=7
RRF_K=60
RERANK_MIN_SCORE=0.05
QUERY_REWRITE_ENABLED=true
GENERATION_MAX_TOKENS=8192
LOG_LEVEL=INFO
